@startuml activity_diagram
!theme plain

skinparam backgroundColor      #FFFFFF
skinparam defaultFontName      "Segoe UI"
skinparam defaultFontSize      12

skinparam activity {
  BackgroundColor #FFF9E6
  BorderColor     #8B6914
  BorderThickness 1.5
  FontSize        12
  ArrowColor      #1A3A7A
  ArrowThickness  1.2
  DiamondBackgroundColor #E3F2FD
  DiamondBorderColor     #1A3A7A
}

skinparam swimlane {
  BorderColor     #003366
  BorderThickness 2
  TitleFontStyle  Bold
  TitleFontSize   12
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor     #AAAAAA
}

title <b>Диаграмма деятельности — Электронный журнал колледжа (EduTrack Pro)</b>

' ═══════════════════════════════════════════════════════
' АВТОРИЗАЦИЯ
' ═══════════════════════════════════════════════════════

|#E8F4FD| Система |
start
:Запуск приложения;
:Отображение формы входа;

|#F0F0F0| Пользователь |
:Ввод логина и пароля;

|#E8F4FD| Система |

while (Аутентификация успешна?) is (нет)
  :Показать сообщение об ошибке;
  |#F0F0F0| Пользователь |
  :Ввод логина и пароля;
  |#E8F4FD| Система |
  :Проверка учётных данных\n(SHA-256 хеш);
endwhile (да)

:Определить роль пользователя;
:Записать LOGIN в журнал аудита;

' ═══════════════════════════════════════════════════════
' ВЕТВЛЕНИЕ ПО РОЛЯМ
' ═══════════════════════════════════════════════════════

if (Роль?) then (Администратор)

  ' ─── Администратор ─────────────────────────────────
  |#FFF3E0| Администратор |
  :Открыть главный дашборд\n(общая статистика системы);

  fork
    :Управление пользователями;
    note right
      Создание, редактирование,
      сброс пароля, деактивация
    end note
    :Назначить / изменить роль;

  fork again
    :Управление учебными данными;
    :Группы · Предметы · Учебные годы\nОбщежития · Преподаватели;

  fork again
    :Просмотр журнала аудита;
    :Фильтрация по дате, действию\nили пользователю;

    if (Нужно восстановить данные?) then (да)
      :Перейти в раздел «Восстановление»;
      :Выбрать удалённую запись;
      :Восстановить запись;
    endif

  end fork

elseif (Роль == Преподаватель) then (Преподаватель)

  ' ─── Преподаватель ─────────────────────────────────
  |#F3E5F5| Преподаватель |
  :Просмотр своего расписания;
  :Выбрать группу и предмет;

  repeat

    :Открыть журнал оценок;
    :Выбрать дату урока;

    while (Остались студенты без оценки?) is (да)
      :Выбрать студента;
      :Выставить оценку (2 – 5);
    endwhile (нет)

    :Записать тему урока\n(заметка к занятию);

    if (Экспортировать журнал в Excel?) then (да)
      :Сформировать .xlsx файл;
      :Сохранить на диск;
    endif

  repeat while (Продолжить работу с журналом?) is (да)
  -> нет;

  :Просмотреть отчёт по посещаемости;

elseif (Роль == Куратор) then (Куратор)

  ' ─── Куратор ───────────────────────────────────────
  |#E8F5E9| Куратор |
  :Открыть дашборд своей группы;

  if (Есть алерты по группе?) then (да)
    note right
      Алерт: ≥ 2 двоек
      или ≥ 4 пропусков/месяц
    end note
    :Просмотреть список\nпроблемных студентов;
    :Зафиксировать принятые меры;
  endif

  fork
    :Отметить посещаемость группы;
    note right
      Статусы: Присутствует /
      Отсутствует / Опоздал / Болен
    end note

  fork again
    :Просмотр успеваемости группы;
    :Анализ средних оценок\nпо предметам;

  fork again
    :Управление достижениями студентов\n(награды, конкурсы, сертификаты);
    :Просмотр и редактирование\nсоциального статуса студентов;

  fork again
    :Создать объявление;
    if (Закрепить объявление?) then (да)
      :Отметить как закреплённое;
    endif

  end fork

elseif (Роль == Староста) then (Староста)

  ' ─── Староста ──────────────────────────────────────
  |#FCE4EC| Староста |
  :Просмотр расписания своей группы;
  :Просмотреть список студентов группы;

  if (Нужно отметить посещаемость?) then (да)
    :Отметить посещаемость\n(ограниченные права);
  endif

  :Просмотреть свои оценки;
  :Просмотреть объявления;

else (Студент)

  ' ─── Студент ───────────────────────────────────────
  |#E0F2F1| Студент |
  :Просмотреть свои оценки\nпо всем предметам;
  :Просмотреть своё расписание;
  :Просмотреть свою посещаемость;

  fork
    :Управление личными документами\n(загрузка, просмотр, скачивание);
  fork again
    :Управление портфолио\n(достижения, награды, конкурсы);
  fork again
    :Просмотр объявлений;
  end fork

endif

' ═══════════════════════════════════════════════════════
' ЗАВЕРШЕНИЕ СЕССИИ
' ═══════════════════════════════════════════════════════

|#F0F0F0| Пользователь |
:Нажать «Выход из системы»;

|#E8F4FD| Система |
:Записать LOGOUT в журнал аудита;
:Очистить данные сессии;
:Вернуться к форме входа;

stop
@enduml
